<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AdCodicem.Pdf</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageId>AdCodicem.Pdf</PackageId>
    <Description>Managed PDF toolkit for .NET with no dependencies: a tolerant, lazy reader that opens damaged third-party files and says what it repaired, and a validator whose findings carry stable rule identifiers. Writing, assembly and HTML to PDF are on the roadmap. Previews carry no compatibility guarantee.</Description>
    <PackageTags>pdf;pdf-reader;pdf-parser;pdf-validation;aot;trimming</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The assembly carries tables derived from the Arlington PDF Model (Apache-2.0): its notice travels with the
         package, and so does the license's text (Apache-2.0, section 4). PackageLicenseExpression stays MIT. -->
    <None Include="$(MSBuildThisFileDirectory)../../NOTICE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../../tools/AdCodicem.Pdf.Arlington/model/LICENSE" Pack="true" PackagePath="licenses/arlington-pdf-model/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdCodicem.Pdf.Tests" />
    <InternalsVisibleTo Include="AdCodicem.Pdf.Benchmarks" />
  </ItemGroup>

</Project>
