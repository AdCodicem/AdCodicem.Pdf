{
  "name": "adcodicem-pdf-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "api": "cd ../.. && dotnet tool restore && dotnet docfx metadata docs/docfx/docfx.json && node docs/website/scripts/tidy-api-reference.mjs",
    "project": "node scripts/sync-project-docs.mjs",
    "generate": "npm run api && npm run project",
    "prestart": "npm run generate",
    "start": "docusaurus start",
    "prebuild": "npm run generate",
    "build": "docusaurus build",
    "postbuild": "npm run check",
    "check": "node scripts/check-site.mjs",
    "test": "node --test scripts/versions.test.mjs",
    "snapshot": "npm run generate && node scripts/version-docs.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
