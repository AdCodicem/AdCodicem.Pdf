<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdCodicem.Pdf.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdCodicem.Pdf/AdCodicem.Pdf.csproj" />
    <ProjectReference Include="../AdCodicem.Pdf.TestSupport/AdCodicem.Pdf.TestSupport.csproj" />
    <!-- The generator of the Arlington tables, whose tests regenerate them and compare them with the committed file.
         Under an alias: it compiles the core's ArlingtonEncoding.cs too, and its copy must not shadow the core's. -->
    <ProjectReference Include="../../tools/AdCodicem.Pdf.Arlington/AdCodicem.Pdf.Arlington.csproj" Aliases="ArlingtonTool" />
    <!-- The tutorial's program, which a test runs to hold its output to what the tutorial shows. -->
    <ProjectReference Include="../../samples/FirstSteps/FirstSteps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="NSubstitute" />
    <Using Include="Xunit" />
    <Using Include="AdCodicem.Pdf.TestSupport" />
    <Using Include="AdCodicem.Pdf.TestSupport.AssertionHelpers" Static="true" />
  </ItemGroup>

</Project>
