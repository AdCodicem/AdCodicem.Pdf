<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks that the rebuild's scan for objects keeps the lexer inlined in its optimized compiles, which nothing a caller
       observes tells and no benchmark run in CI would (#374). CI runs it after the build, and so does the batch check
       (.claude/scripts/batch-check.sh); it exits non-zero when an optimized compile leaves the lexer out. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdCodicem.Pdf.InliningCheck</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AdCodicem.Pdf/AdCodicem.Pdf.csproj" />
  </ItemGroup>

</Project>
