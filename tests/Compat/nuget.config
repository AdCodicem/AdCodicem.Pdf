<?xml version="1.0" encoding="utf-8"?>
<!--
  The package under test comes from the folder the root build packs into, and from nowhere else: a copy of the same
  version on nuget.org, or anywhere a user-level configuration points, must never stand in for what this commit built.
  Anything else would come from nuget.org; today nothing else is restored but what the SDK adds. The folder is relative
  to this file: artifacts/packages at the repository root, where
  `dotnet pack src/AdCodicem.Pdf.Packages.slnf -c Release -o artifacts/packages` writes and where CI downloads the build
  job's `packages` artifact. A missing folder fails the restore rather than falling back to another source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="AdCodicem.Pdf" />
      <package pattern="AdCodicem.Pdf.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
