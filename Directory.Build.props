<Project>

  <PropertyGroup Label="Platform">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <!-- A warning nobody has to fix is a warning nobody reads. The build has none, and keeps none. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Performance">
    <!-- The rendering pipeline is span/pool based; unsafe blocks stay off until a benchmark justifies one. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Authors>AdCodicem</Authors>
    <Company>AdCodicem</Company>
    <Product>AdCodicem.Pdf</Product>
    <Copyright>Copyright (c) AdCodicem</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adcodicem/adcodicem.pdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adcodicem/adcodicem.pdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- Fails the build on an accidental breaking API change. The baseline is supplied by the release
         pipeline as the version last actually published, so it is a no-op until there is one. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- A build nobody handed a version to is not a release build. release-pack.sh passes -p:Version
         explicitly - a preview as 0.2.0-preview.292, a stable release as the number semantic-release
         works out - and an explicit Version overrides prefix and suffix alike. -->
    <VersionSuffix Condition="'$(Version)' == ''">alpha</VersionSuffix>
  </PropertyGroup>

  <!-- release-pack.sh holds each package to the API of the last release, except one nuget.org does not have at
       that version - a package added since -, whose baseline would fail to restore. It passes the version, and
       the projects to leave out by project name, which is known at this point; PackageId is defaulted later. -->
  <PropertyGroup Condition="'$(ReleaseBaselineVersion)' != '' and !$([System.String]::Copy(' $(ProjectsWithoutBaseline) ').Contains(' $(MSBuildProjectName) '))">
    <PackageValidationBaselineVersion>$(ReleaseBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
