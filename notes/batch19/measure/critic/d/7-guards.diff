+    /// <summary>
+    /// A file of two revisions (#264, shapes F and G). The first, a classic table, holds the catalog, the page tree and the
+    /// page, objects 1 to 3, and gives <c>/Root</c>. The second updates objects 2 and 3 and numbers its rows as
+    /// <c>0 1</c>, <c>21 1</c> — a free row —, <c>2 2</c> and <c>4 40</c> — free rows —, its trailer giving <c>/Size 44</c>,
+    /// no <c>/Root</c>, and <paramref name="prev"/>, in which <c>{self}</c> stands for its own offset and <c>{older}</c> for
+    /// the first table's: a classic table, or, with <paramref name="stream"/>, cross-reference stream 44, whose
+    /// ASCIIHex-encoded rows of 7 bytes are numbered so through its <c>/Index</c>, its own row last.
+    /// <c>MaxXRefSectionLength = 128</c> cuts the table's rows in its fifth, <c>MaxDecodedStreamLength = 35</c> the stream's
+    /// after it, and <c>MaxIndexEntries = 4</c> fills the index at it, in either.
+    /// </summary>
+    public static (byte[] File, long Section) SectionAGuardStops(string prev, bool stream = false)
+    {
+        var file = new HandWrittenFile();
+        var one = file.Object(1, "<< /Type /Catalog /Pages 2 0 R >>");
+        var two = file.Object(2, "<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
+        var three = file.Object(3, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 1 1] /Resources << >> >>");
+        var older = file.Table(4, new Dictionary<int, long> { [1] = one, [2] = two, [3] = three }, "/Size 4 /Root 1 0 R");
+        two = file.Object(2, "<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
+        three = file.Object(3, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 2 2] /Resources << >> >>");
+        var section = file.Position;
+        var link = prev
+            .Replace("{self}", section.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)
+            .Replace("{older}", older.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal);
+
+        if (stream)
+        {
+            var data = Row(0, 0, 65535) + Row(0, 0, 0) + Row(1, two, 0) + Row(1, three, 0) +
+                string.Concat(Enumerable.Repeat(Row(0, 0, 0), 40)) + Row(1, section, 0) + ">";
+            file.Raw(string.Create(
+                CultureInfo.InvariantCulture,
+                $"44 0 obj\n<< /Type /XRef /Size 45 /Index [0 1 21 1 2 2 4 40 44 1] /W [1 4 2] /Filter /ASCIIHexDecode /Prev {link} /Length {data.Length} >>\nstream\n{data}\nendstream\nendobj\n"));
+        }
+        else
+        {
+            var free = string.Concat(Enumerable.Repeat("0000000000 00000 f \n", 40));
+            file.Raw(string.Create(
+                CultureInfo.InvariantCulture,
+                $"xref\n0 1\n0000000000 65535 f \n21 1\n0000000000 00000 f \n2 2\n{two:D10} 00000 n \n{three:D10} 00000 n \n4 40\n{free}trailer\n<< /Size 44 /Prev {link} >>\n"));
+        }
+
+        file.Raw(string.Create(CultureInfo.InvariantCulture, $"startxref\n{section}\n%%EOF\n"));
+        return (file.Bytes, section);
+
+        static string Row(int type, long offset, int generation) =>
+            string.Create(CultureInfo.InvariantCulture, $"{type:X2}{offset:X8}{generation:X4}");
+    }
+
+    /// <summary>
+    /// A file of two revisions, as <see cref="SectionAGuardStops"/> writes them, the second a hybrid section: cross-reference
+    /// stream 44, numbered as there and with no <c>/Prev</c> of its own, then a classic table of object 0 alone whose trailer
+    /// names the stream through <c>/XRefStm</c> and gives <paramref name="prev"/>, in which <c>{self}</c> stands for the
+    /// table's offset, <c>{stream}</c> for the stream's and <c>{older}</c> for the first table's.
+    /// </summary>
+    public static (byte[] File, long Table) HybridWhoseStreamAGuardStops(string prev)
+    {
+        var file = new HandWrittenFile();
+        var one = file.Object(1, "<< /Type /Catalog /Pages 2 0 R >>");
+        var two = file.Object(2, "<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
+        var three = file.Object(3, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 1 1] /Resources << >> >>");
+        var older = file.Table(4, new Dictionary<int, long> { [1] = one, [2] = two, [3] = three }, "/Size 4 /Root 1 0 R");
+        two = file.Object(2, "<< /Type /Pages /Kids [3 0 R] /Count 1 >>");
+        three = file.Object(3, "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 2 2] /Resources << >> >>");
+        var stream = file.Position;
+        var data = Row(0, 0, 65535) + Row(0, 0, 0) + Row(1, two, 0) + Row(1, three, 0) +
+            string.Concat(Enumerable.Repeat(Row(0, 0, 0), 40)) + Row(1, stream, 0) + ">";
+        file.Raw(string.Create(
+            CultureInfo.InvariantCulture,
+            $"44 0 obj\n<< /Type /XRef /Size 45 /Index [0 1 21 1 2 2 4 40 44 1] /W [1 4 2] /Filter /ASCIIHexDecode /Length {data.Length} >>\nstream\n{data}\nendstream\nendobj\n"));
+        var table = file.Position;
+        var link = prev
+            .Replace("{self}", table.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)
+            .Replace("{stream}", stream.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal)
+            .Replace("{older}", older.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal);
+        file.Raw(string.Create(
+            CultureInfo.InvariantCulture,
+            $"xref\n0 1\n0000000000 65535 f \ntrailer\n<< /Size 45 /XRefStm {stream} /Prev {link} >>\nstartxref\n{table}\n%%EOF\n"));
+        return (file.Bytes, table);
+
+        static string Row(int type, long offset, int generation) =>
+            string.Create(CultureInfo.InvariantCulture, $"{type:X2}{offset:X8}{generation:X4}");
+    }
