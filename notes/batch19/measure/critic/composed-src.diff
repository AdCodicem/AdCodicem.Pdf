@@ -0,0 +1,54 @@
+using System.Globalization;
+
+namespace AdCodicem.Pdf.Validation.Rules;
+
+/// <summary>
+/// <see cref="PdfValidationRuleIds.XRefEntryTypeReserved"/>: no cross-reference stream the chain reads gives a row of a
+/// reserved type — a type past 2, which ISO 32000-1 (7.5.8.3) allows no PDF 1.5 to 1.7 file, "thus permitting new entry
+/// types to be defined in the future".
+/// </summary>
+/// <remarks>
+/// ISO 32000-1 reads such a row as a reference to the null object, and so does the reader, no older section's row
+/// standing for its object (#221): the file breaks the specification and is read as the specification says, a warning
+/// (ADR 45), as a reference to an object the file lacks is (<see cref="PdfValidationRuleIds.ObjectReferenceMissing"/>).
+/// What a later version may define the type to stand for is unknown to the reader. Each section that gives such rows is
+/// reported once, the first named, the others counted — a section the reader could not read whole too: the rows it read
+/// are the file's.
+/// </remarks>
+internal sealed class ReservedTypeRule : IValidationRule
+{
+    /// <inheritdoc/>
+    public string Id => PdfValidationRuleIds.XRefEntryTypeReserved;
+
+    /// <inheritdoc/>
+    public PdfValidationSeverity Severity => PdfValidationSeverity.Warning;
+
+    /// <inheritdoc/>
+    public void Check(ValidationContext context)
+    {
+        foreach (var section in context.Structure.Sections)
+        {
+            // Past the report's room, the section is counted, its finding not written (#168).
+            if (section.ReservedRow is not { } first || !context.HasRoomFor(this))
+            {
+                continue;
+            }
+
+            var more = section.ReservedRows - 1;
+            var others = more switch
+            {
+                0 => string.Empty,
+                1 => ", and 1 row more",
+                _ => string.Create(CultureInfo.InvariantCulture, $", and {more} rows more"),
+            };
+
+            context.Report(
+                this,
+                PdfValidationLocation.AtPosition(section.Offset),
+                string.Create(
+                    CultureInfo.InvariantCulture,
+                    $"The cross-reference stream at offset {section.Offset} gives a row a reserved type: {first}{others}. ISO 32000-1 allows types 0, 1 and 2 only, and reads the object as null."),
+                "Rewrite the cross-reference stream with a row of type 0, 1 or 2 for each object.");
+        }
+    }
+}
