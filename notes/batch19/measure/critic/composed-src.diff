@@ -0,0 +1,44 @@
+using System.Globalization;
+
+namespace AdCodicem.Pdf.Validation.Rules;
+
+/// <summary>
+/// <see cref="PdfValidationRuleIds.XRefHybridStreamWrong"/>: a hybrid table's <c>/XRefStm</c> names the cross-reference
+/// stream of its revision.
+/// </summary>
+/// <remarks>
+/// ISO 32000-1 makes <c>/XRefStm</c> the offset of a cross-reference stream (Table 19), which holds the rows the table
+/// leaves out for readers of PDF 1.4 (7.5.8.4). One that names a classic table — the table itself, another the chain reads,
+/// or one it reads in the stream's place —, or a section the chain reads through <c>/Prev</c> or <c>startxref</c>, leaves
+/// that stream unknown: what only it indexed is found, if at all, by rebuilding the index, after which the reader cannot
+/// vouch that it reads what was written — an error (ADR 45), as a section that cannot be found is (#156).
+/// </remarks>
+internal sealed class HybridStreamWrongRule : IValidationRule
+{
+    /// <inheritdoc/>
+    public string Id => PdfValidationRuleIds.XRefHybridStreamWrong;
+
+    /// <inheritdoc/>
+    public PdfValidationSeverity Severity => PdfValidationSeverity.Error;
+
+    /// <inheritdoc/>
+    public void Check(ValidationContext context)
+    {
+        foreach (var section in context.Structure.Sections)
+        {
+            // Past the report's room, the section is counted, its finding not written (#168).
+            if (section.NamesNoStream is not { } what || !context.HasRoomFor(this))
+            {
+                continue;
+            }
+
+            context.Report(
+                this,
+                PdfValidationLocation.AtPosition(section.NamedFrom),
+                string.Create(
+                    CultureInfo.InvariantCulture,
+                    $"The /XRefStm of the cross-reference table at offset {section.NamedFrom} names offset {context.Document.Reader.DescribeOffset(section.WrittenOffset)}, {what}, where ISO 32000-1 names the cross-reference stream of the table's revision (Table 19): what only that stream indexes is lost."),
+                "Point /XRefStm at the cross-reference stream of the table's revision, or remove it.");
+        }
+    }
+}
