+    /// <summary>The guards that stop a section's rows, by the name the theories give them, as #264's shapes reach them.</summary>
+    private static PdfReaderOptions RowGuard(string guard) => new()
+    {
+        Limits = guard switch
+        {
+            "table rows" => PdfReaderLimits.Default with { MaxXRefSectionLength = 128 },
+            "stream rows" => PdfReaderLimits.Default with { MaxDecodedStreamLength = 35 },
+            _ => PdfReaderLimits.Default with { MaxIndexEntries = 4 },
+        },
+    };
+
+    [Theory]
+    [InlineData("21 0 R", "table rows")]
+    [InlineData("21 0 R", "table index")]
+    [InlineData("21 0 R", "stream rows")]
+    [InlineData("21 0 R", "stream index")]
+    [InlineData("99999999", "table rows")]
+    [InlineData("99999999", "table index")]
+    [InlineData("99999999", "stream rows")]
+    [InlineData("99999999", "stream index")]
+    [InlineData("{self}", "table rows")]
+    [InlineData("{self}", "table index")]
+    [InlineData("{self}", "stream rows")]
+    [InlineData("{self}", "stream index")]
+    public void A_section_a_guard_stops_reports_the_faults_of_its_prev_a_whole_read_reports(string prev, string guard)
+    {
+        // #264, shapes F and G: the newest section's rows run past MaxXRefSectionLength or MaxDecodedStreamLength, or fill
+        // MaxIndexEntries, and its /Prev names a free row the guard let the reader read, an offset outside the file, or the
+        // section itself. The chain ended at the section for the guard and said nothing of the /Prev, which a whole read
+        // reports: what it names is no section, whatever the guard hid. The guard is reported first, then the /Prev as read
+        // whole, and the index is rebuilt for the /Root the trailers then lack, as read whole.
+        var (file, _) = ChainFiles.SectionAGuardStops(prev, stream: guard.StartsWith("stream", StringComparison.Ordinal));
+        var limit = guard.EndsWith("rows", StringComparison.Ordinal)
+            ? guard.StartsWith("table", StringComparison.Ordinal) ? PdfDiagnosticCodes.LimitXRefSectionLength : PdfDiagnosticCodes.LimitDecodedStream
+            : PdfDiagnosticCodes.LimitIndexEntries;
+
+        using var whole = PdfDocument.Open(file);
+        using var document = PdfDocument.Open(file, RowGuard(guard));
+
+        var faults = whole.Diagnostics.Where(entry => entry.Code is PdfDiagnosticCodes.XRefSectionMissing or PdfDiagnosticCodes.XRefChainCycle).ToList();
+        faults.Should().ContainSingle();
+        document.Diagnostics.Select(entry => entry.Code).Should().StartWith([limit, faults[0].Code]);
+        document.Diagnostics.Should().Contain(faults[0]);
+        document.Reader.Structure.TrailersHiddenByGuard.Should().BeFalse();
+        document.WasRepaired.Should().Be(whole.WasRepaired).And.BeTrue();
+
+        var throwing = () => PdfDocument.Open(file, RowGuard(guard) with { ThrowOnLimit = true });
+        throwing.Should().Throw<PdfLimitExceededException>();
+    }
+
+    [Theory]
+    [InlineData("30 0 R", "table rows")]
+    [InlineData("30 0 R", "table index")]
+    [InlineData("30 0 R", "stream rows")]
+    [InlineData("30 0 R", "stream index")]
+    [InlineData("{older}", "table rows")]
+    [InlineData("{older}", "table index")]
+    [InlineData("{older}", "stream rows")]
+    [InlineData("{older}", "stream index")]
+    public void A_prev_a_section_a_guard_stops_names_that_may_be_sound_stays_the_guard_s(string prev, string guard)
+    {
+        // #264: the /Prev names a row the guard left unread — free, read whole, which a whole read reports —, or the older
+        // section, in the file. Either may name a sound section as far as the reader can tell without reading past the guard:
+        // the chain ends there for the guard, which is the only report, and the older trailers are the guard's to hide.
+        var (file, _) = ChainFiles.SectionAGuardStops(prev, stream: guard.StartsWith("stream", StringComparison.Ordinal));
+
+        using var document = PdfDocument.Open(file, RowGuard(guard));
+
+        document.Diagnostics.Should().ContainSingle().Which.Code.Should().StartWith("limit.");
+        document.Reader.Structure.TrailersHiddenByGuard.Should().BeTrue();
+        document.Reader.Structure.Sections.Should().ContainSingle();
+        document.WasRepaired.Should().BeFalse();
+        using var whole = PdfDocument.Open(file);
+        whole.Diagnostics.Any(entry => entry.Code == PdfDiagnosticCodes.XRefSectionMissing).Should().Be(prev == "30 0 R");
+    }
+
+    [Theory]
+    [InlineData("99999999", "stream rows")]
+    [InlineData("99999999", "stream index")]
+    [InlineData("{self}", "stream rows")]
+    [InlineData("{self}", "stream index")]
+    [InlineData("{stream}", "stream rows")]
+    [InlineData("{stream}", "stream index")]
+    public void A_table_whose_hybrid_stream_a_guard_stops_reports_the_faults_of_its_prev_a_whole_read_reports(string prev, string guard)
+    {
+        // #264, beside shapes F and G: the table is read whole, and the cross-reference stream its /XRefStm names is the
+        // section the guard stops, which ends the chain. The table's /Prev, an offset outside the file, the table itself or
+        // the stream the chain read, names no section whatever the guard hid: it is reported as read whole.
+        var (file, _) = ChainFiles.HybridWhoseStreamAGuardStops(prev);
