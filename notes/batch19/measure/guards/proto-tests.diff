+
+        var fault = whole.Diagnostics.Should().ContainSingle(entry => entry.Code == PdfDiagnosticCodes.XRefSectionMissing || entry.Code == PdfDiagnosticCodes.XRefChainCycle).Which;
+        document.Diagnostics.Should().Contain(fault);
+        document.Diagnostics[0].Code.Should().StartWith("limit.");
+        document.Reader.Structure.TrailersHiddenByGuard.Should().BeFalse();
+    }
