+    /// <summary>
+    /// Records that <paramref name="table"/>'s <c>/XRefStm</c> names <paramref name="offset"/>, which the chain has named
+    /// before: a hybrid file's stream a newer table named too — a writer that copies <c>/XRefStm</c> into the next trailer —,
+    /// read once, where it was first named. Its rows count for each table that names it (#156).
+    /// </summary>
+    /// <remarks>
+    /// Run once for each table the chain reads, over the records made so far: at most twice as many as the sections the
+    /// chain may read.
+    /// </remarks>
+    private void NameAgain(long offset, XRefSectionRecord table)
+    {
+        XRefSectionRecord? first = null;
+
+        foreach (var section in _structure.Sections)
+        {
+            if (section.WrittenOffset == offset)
+            {
+                first = section;
+                break;
+            }
+        }
+
+        var again = new XRefSectionRecord("/XRefStm", PositionOf(offset), table.Offset)
+        {
+            WrittenOffset = offset,
+            NamingTrailer = table.Trailer,
+            ReadAs = first,
+        };
+        again.State = XRefSectionState.NamedAgain;
+        again.Kind = first?.Kind ?? XRefSectionKind.Unknown;
+
+        // A hybrid file's stream is part of each revision whose table names it; what the chain read through /Prev or
+        // startxref, or a table, is no table's stream.
+        again.HighestNumber = first is { NamedBy: "/XRefStm", Kind: XRefSectionKind.Stream } ? first.HighestNumber : -1;
+        _structure.Add(again);
+    }
+
     /// <summary>
     /// Determines whether the chain read a section it named at <paramref name="offset"/>, as the file writes it: where it was
     /// named, or near it.
