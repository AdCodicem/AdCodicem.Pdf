<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Rendering">
    <!-- HTML5 parsing only: the CSS cascade and the layout engine are ours (see docs/architecture.md). -->
    <PackageVersion Include="AngleSharp" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <!-- Property-based testing. Referenced without FsCheck.Xunit, whose runner integration still pins
         xunit.extensibility.execution below 3.0.0 and would drag xUnit v2 into a v3 suite. The library
         itself is runner-agnostic, so a property runs inside an ordinary fact. -->
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <!-- Holds the corpus manifest to its JSON schema (tests/corpus/manifest.schema.json). The framework exports
         schemas but does not validate against one, and the core must not take the dependency; the tests may. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmark">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
